@model PersonelFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Personel" : "Personeli Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">@ViewData["Title"]</h2>

        <form asp-action="PersonelForm" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Ad" class="form-label"></label>
                    <input asp-for="Ad" class="form-control" />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Soyad" class="form-label"></label>
                    <input asp-for="Soyad" class="form-control" />
                    <span asp-validation-for="Soyad" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Gorev" class="form-label"></label>
                    <input asp-for="Gorev" class="form-control" list="gorevOnerileri" />
                    <datalist id="gorevOnerileri">
                        <option value="Hemşire"></option>
                        <option value="Laborant"></option>
                        <option value="Radyoloji Teknisyeni"></option>
                        <option value="Sağlık Teknikeri"></option>
                        <option value="Hasta Kabul Görevlisi"></option>
                    </datalist>
                    <span asp-validation-for="Gorev" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="SicilNo" class="form-label"></label>
                    <input asp-for="SicilNo" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Eposta" class="form-label"></label>
                    <input asp-for="Eposta" class="form-control" />
                    <span asp-validation-for="Eposta" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon" class="form-control" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="IseBaslamaTarihi" class="form-label"></label>
                    <input asp-for="IseBaslamaTarihi" class="form-control" />
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Sifre" class="form-label"></label>
                    <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                    <div class="form-text">
                        @(Model.Id == 0 ? "Personel sisteme bu şifreyle giriş yapacak." : "Değiştirmek istemiyorsanız boş bırakın.")
                    </div>
                    <span asp-validation-for="Sifre" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Personel" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}