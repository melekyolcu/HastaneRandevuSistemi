@model List<Doktor>
@{
    ViewData["Title"] = "Doktorlar";
}

<partial name="_YonetimMenu" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Doktorlar</h2>
    <a asp-action="DoktorForm" class="btn btn-primary">+ Yeni Doktor</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz doktor eklenmemiş.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Doktor</th>
                    <th>Uzmanlık</th>
                    <th>Bölüm / Şube</th>
                    <th>Hizmet</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doktor in Model)
                {
                    <tr>
                        <td>
                            <strong>@doktor.Unvan @doktor.AdSoyad</strong><br />
                            <small class="text-muted">@doktor.Eposta</small>
                        </td>
                        <td>@doktor.UzmanlikAlani</td>
                        <td>
                            @doktor.Bolum.Ad<br />
                            <small class="text-muted">@doktor.Bolum.Sube.Ad</small>
                        </td>
                        <td>@doktor.Hizmetler.Count</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="DoktorDetay" asp-route-id="@doktor.Id" class="btn btn-sm btn-outline-primary">Hizmetler ve Saatler</a>
                            <a asp-action="DoktorForm" asp-route-id="@doktor.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            <form asp-action="DoktorSil" asp-route-id="@doktor.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu doktor silinsin mi?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}