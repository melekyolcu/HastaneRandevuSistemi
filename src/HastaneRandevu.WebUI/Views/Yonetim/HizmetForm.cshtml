@model HizmetFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Hizmet" : "Hizmeti Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <p class="text-muted mb-4">@Model.BolumAdi</p>

        <form asp-action="HizmetForm" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BolumId" />
            <input type="hidden" asp-for="SubeId" />
            <input type="hidden" asp-for="BolumAdi" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Ad" class="form-label"></label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Kategori" class="form-label"></label>
                <select asp-for="Kategori" asp-items="Html.GetEnumSelectList<HizmetKategorisi>()" class="form-select"></select>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="SureDakika" class="form-label"></label>
                    <input asp-for="SureDakika" class="form-control" min="1" max="480" />
                    <span asp-validation-for="SureDakika" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Ucret" class="form-label"></label>
                    <input asp-for="Ucret" class="form-control" min="0" />
                    <span asp-validation-for="Ucret" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label"></label>
                <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Sube" asp-route-id="@Model.SubeId" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}