@model List<Randevu>
@using System.Globalization
@{
    ViewData["Title"] = "Randevularım";
    var tr = new CultureInfo("tr-TR");
    var simdi = DateTime.Now;
    var gelecek = Model.Where(r => r.BaslangicZamani >= simdi).OrderBy(r => r.BaslangicZamani).ToList();
    var gecmis = Model.Where(r => r.BaslangicZamani < simdi).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Randevularım</h2>
    <a asp-action="Al" class="btn btn-primary">+ Randevu Al</a>
</div>

<h4 class="mb-3">Yaklaşan Randevular</h4>

@if (!gelecek.Any())
{
    <p class="text-muted mb-5">Yaklaşan randevunuz yok.</p>
}
else
{
    <div class="list-group mb-5">
        @foreach (var r in gelecek)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <strong>@r.BaslangicZamani.TarihYaz() · @r.BaslangicZamani.ToString("HH:mm")</strong>
                        <span class="badge bg-@r.Durum.Renk() ms-2">@r.Durum.GorunenAd()</span><br />
                        @r.Doktor.Unvan @r.Doktor.AdSoyad · @r.Hizmet.Ad
                        <small class="text-muted">(@r.SureDakika dk, @r.Ucret.ToString("N2", tr) ₺)</small>
                        @if (!string.IsNullOrEmpty(r.RedNedeni))
                        {
                            <div class="small text-danger mt-1">Red nedeni: @r.RedNedeni</div>
                        }
                    </div>
                    @if (r.SlotuMesgulEdiyorMu)
                    {
                        <form asp-action="IptalEt" asp-route-id="@r.Id" method="post"
                              onsubmit="return confirm('Randevu iptal edilsin mi?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">İptal Et</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

<h4 class="mb-3">Geçmiş Randevular</h4>

@if (!gecmis.Any())
{
    <p class="text-muted">Geçmiş randevunuz yok.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Doktor</th>
                    <th>Hizmet</th>
                    <th>Ücret</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in gecmis)
                {
                    <tr>
                        <td class="text-nowrap">@r.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.Doktor.Unvan @r.Doktor.AdSoyad</td>
                        <td>@r.Hizmet.Ad</td>
                        <td>@r.Ucret.ToString("N2", tr) ₺</td>
                        <td><span class="badge bg-@r.Durum.Renk()">@r.Durum.GorunenAd()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}