@model GirisViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4">Giriş Yap</h2>

        <form asp-action="Giris" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Eposta" class="form-label"></label>
                <input asp-for="Eposta" class="form-control" autocomplete="username" />
                <span asp-validation-for="Eposta" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sifre" class="form-label"></label>
                <input asp-for="Sifre" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Sifre" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="BeniHatirla" class="form-check-input" />
                <label asp-for="BeniHatirla" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
        </form>

        <p class="mt-3 text-center">
            Hesabınız yok mu? <a asp-action="Kayit">Kayıt olun</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}