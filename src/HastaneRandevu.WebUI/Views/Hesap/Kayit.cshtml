@model KayitViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h2 class="mb-4">Hasta Kaydı</h2>

        <form asp-action="Kayit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Ad" class="form-label"></label>
                    <input asp-for="Ad" class="form-control" />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Soyad" class="form-label"></label>
                    <input asp-for="Soyad" class="form-control" />
                    <span asp-validation-for="Soyad" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="TcKimlikNo" class="form-label"></label>
                    <input asp-for="TcKimlikNo" class="form-control" maxlength="11" />
                    <span asp-validation-for="TcKimlikNo" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="DogumTarihi" class="form-label"></label>
                    <input asp-for="DogumTarihi" class="form-control" />
                    <span asp-validation-for="DogumTarihi" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Eposta" class="form-label"></label>
                    <input asp-for="Eposta" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Eposta" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon" class="form-control" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Sifre" class="form-label"></label>
                    <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Sifre" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="SifreTekrar" class="form-label"></label>
                    <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="SifreTekrar" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
        </form>

        <p class="mt-3 text-center">
            Zaten hesabınız var mı? <a asp-action="Giris">Giriş yapın</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}